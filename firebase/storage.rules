rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Top-level prefixes owned by the Lens hardware-ingest pipeline. These are
    // carved out of the legacy public-read catch-all below (rules `allow`
    // statements are OR-ed across overlapping matches, so the catch-all must
    // explicitly exclude them).
    function isLensPrefix(segment) {
      return segment == 'lens-ingest' || segment == 'lens-quarantine';
    }

    // intel-media/** (issue #141) — scraped post media staged for staff
    // review, same "carve out of the public catch-all" reasoning as the
    // Lens prefixes above.
    function isIntelMediaPrefix(segment) {
      return segment == 'intel-media';
    }

    // published-media/** (issue #159) — copy-on-publish destination for
    // staged intel-media/** assets, carved out of the catch-all the same
    // way, so its own `allow read: if true` below isn't OR-ed against the
    // catch-all's any-authed-write grant for this prefix.
    function isPublishedMediaPrefix(segment) {
      return segment == 'published-media';
    }

    // ── Lens ingest ──────────────────────────────────────────────────
    // lens-ingest/{deviceId}/{galleryId}/{filename}
    // Hardware capture devices authenticate as dedicated Firebase Auth users
    // carrying a `lensDeviceId` custom claim (set by scripts/lens-provision-
    // device.js). A device may only write inside its own deviceId folder.
    // No reads via rules: originals are preserved here for the paid tier and
    // are only touched by the ingest Cloud Function (Admin SDK bypasses rules).
    match /lens-ingest/{deviceId}/{galleryId}/{fileName} {
      allow read: if false;
      allow write: if request.auth != null
        && request.auth.token.lensDeviceId == deviceId
        && request.resource.size < 30 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Quarantined uploads (device/gallery mismatch) — Cloud Function only.
    match /lens-quarantine/{allPaths=**} {
      allow read, write: if false;
    }

    // ── Intel media (Apify scrape staging) ──────────────────────────
    // intel-media/{venueIntelDocId}/{index}.jpg — media downloaded from
    // scraped IG posts (apifyWebhook / scripts/backfill-intel-media.js),
    // tracked per-asset in Firestore mediaAssets/{venueIntelDocId} with
    // rightsStatus starting 'unverified'. Not yet cleared for any
    // consumer- or dashboard-client-facing use, so client reads are
    // denied outright here — no existing dashboard-staff Storage rule
    // pattern to match (checked: dashboard's only comparable route,
    // venue-intel/image, proxies the external IG CDN, not Firebase
    // Storage). When the dashboard needs to display these, it should add
    // an authed server route that reads via the Admin SDK (bypasses these
    // rules) and streams the bytes back, gated by the existing
    // requireVenueIntelStaff() check — same shape as that IG-CDN proxy
    // route, just backed by admin.storage() instead of fetch(). Write is
    // Cloud Function / Admin SDK only.
    match /intel-media/{allPaths=**} {
      allow read, write: if false;
    }

    // Web/thumb renditions written by the ingest function (Admin SDK).
    // Publicly readable like all other Wugi media; never client-written.
    match /lens-renditions/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // ── Published media (copy-on-publish, issue #159) ────────────────
    // published-media/{venueIntelDocId}/{index}.{ext} — permanent copies of
    // intel-media/** assets, minted by dashboard/lib/publishMedia.ts at
    // publish time so the picker's 60-minute signed URL never has to live
    // in Firestore. Keyed by venueIntelDocId (not eventId) so a flyer reused
    // across series occurrences is one object with one download token.
    // Publicly readable (consumer app renders these directly); write is
    // Admin SDK only (the dashboard's server-side publish/media routes).
    match /published-media/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // ── Legacy catch-all ─────────────────────────────────────────────
    // Preserves the pre-Lens behavior (public read, any-authed write) for
    // every existing path, while excluding the private Lens prefixes.
    // With rules_version 2, {allPaths=**} matches zero or more segments, so
    // this covers root-level objects too.
    match /{topLevel}/{allPaths=**} {
      allow read: if !isLensPrefix(topLevel) && !isIntelMediaPrefix(topLevel) && !isPublishedMediaPrefix(topLevel);
      // lens-renditions and published-media stay publicly readable but are
      // function/server-written only, so both must also be excluded from
      // the legacy any-authed-write grant.
      allow write: if request.auth != null
        && !isLensPrefix(topLevel)
        && !isIntelMediaPrefix(topLevel)
        && !isPublishedMediaPrefix(topLevel)
        && topLevel != 'lens-renditions';
    }

  }
}
